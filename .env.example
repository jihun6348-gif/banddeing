# 배포할 때 호스팅 서비스의 "Environment Variables" 화면에 이 이름과 값을 넣어요.
# (이 파일 자체는 서버에서 읽지 않아요. 값 옆에 주석을 붙이지 마세요.)

# ── 필수 ────────────────────────────────────
# 배포 모드
APP_ENV=production
# 아무도 모르는 긴 무작위 문자열: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# DB와 사진을 저장할 영구 디스크 경로
DATA_DIR=/var/data
# 실제 접속 주소 (필수: 비밀번호 재설정 메일·공유 링크·카카오 로그인 주소에 쓰여요. 비우면 재설정 메일이 안 나가요)
PUBLIC_URL=https://banddeing.onrender.com

# ── 운영 정보 (약관·개인정보처리방침에 표시돼요) ──
OPERATOR_NAME=웹프로그래밍 8조 반띵팀
CONTACT_EMAIL=your-team@example.com
PRIVACY_OFFICER=홍길동
HOSTING_PROVIDER=Render Services, Inc. (미국)
POLICY_EFFECTIVE_DATE=2026-11-01
# 이 이메일로 가입한 뒤 이메일 인증까지 마친 계정이 운영자 화면(신고 처리, 이용 정지, 상점 등록)을 봐요. 쉼표로 여러 명
# 메일 설정이 없으면 서버 Shell 에서:  flask --app app verify-admin 운영자이메일
ADMIN_EMAILS=your-team@example.com

# ── 선택: 카카오 로그인 ───────────────────────
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ── 선택: 메일 (비밀번호 재설정 · 학교 인증 · 신고 알림) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-team@example.com
SMTP_PASSWORD=
MAIL_FROM=반띵 <your-team@example.com>

# ── 로컬 시연 전용 ─────────────────────────────
# DEMO_MODE=1 이면 데모 데이터와 데모 로그인 버튼이 켜져요. 배포에서는 절대 켜지 마세요.
